# J.A.R.V.I.S. — Schlüssel und Einstellungen des lokalen Dienstes
#
# Diese Datei ist nur die Vorlage. Zum Benutzen kopieren:
#
#   cp server/.env.example server/.env
#
# server/.env steht in .gitignore und wird nie mit hochgeladen.
# Schlüssel gehören ausschließlich hierher — nie in eine Nachricht,
# nie in den Quelltext, nie in ein Repository.

# Claude — für den KI-Modus und den Agenten.
# Zu holen unter https://console.anthropic.com → API keys
ANTHROPIC_API_KEY=

# ElevenLabs — für die eigene Stimme. Ohne diesen Schlüssel spricht
# J.A.R.V.I.S. mit der Systemstimme des Browsers weiter.
# Zu holen unter https://elevenlabs.io → Profil → API Keys
ELEVENLABS_API_KEY=

# ---- Optionale Einstellungen ----

# Ordner, in dem der Agent arbeiten darf (Standard: ~/jarvis-workspace)
# JARVIS_WORKSPACE=/pfad/zum/ordner

# Obergrenzen je Auftrag
# JARVIS_AGENT_MAX_TURNS=40
# JARVIS_AGENT_BUDGET_USD=2

# Wie lange eine Rückfrage auf Antwort wartet (Millisekunden)
# JARVIS_PERMISSION_TIMEOUT_MS=120000

# Zusätzlich erlaubte Herkunftsadressen, mit Komma getrennt
# JARVIS_ALLOWED_ORIGINS=http://localhost:8000

# Port des Dienstes
# PORT=8787
